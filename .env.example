# ============================================================
#  V PRIME PRO — variáveis opcionais do build (Vite)
# ============================================================
# NÃO é preciso criar .env para publicar: sem ele, o site sai como está configurado.
# Para personalizar: copie para ".env", altere e rode "npm run build" de novo.
# Tudo que começa com VITE_ vai para o JavaScript público. NUNCA coloque tokens aqui.

# true = mostra seções ainda não validadas (ex.: comparação de preços).
# false ESCONDE a seção de comparação e o card "protegido por senha".
VITE_DEMO_MODE=true

# Links de checkout (vazio = usa os links da Braip definidos em src/config/site.js)
VITE_CHECKOUT_INDIVIDUAL=
VITE_CHECKOUT_FAMILIA=
VITE_CHECKOUT_PREMIUM=

# Suporte — somente números, com DDI e DDD (ex.: 5511999999999)
VITE_WHATSAPP_NUMBER=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_HOURS=

# Garantia de 7 dias (false esconde a seção)
VITE_GUARANTEE_CONFIRMED=true
# Sincronização entre dispositivos ("continue de onde parou") confirmada?
VITE_SYNC_CONFIRMED=false
# Proteção por senha da categoria adulta confirmada?
VITE_ADULT_PIN_CONFIRMED=false

# Dados da empresa (rodapé) — exigidos pelo Decreto 7.962/2013 em lojas virtuais
VITE_COMPANY_NAME=
VITE_COMPANY_CNPJ=
VITE_COMPANY_ADDRESS=

# Documentos legais (URLs). A política de privacidade aparece no aviso de cookies.
VITE_URL_PRIVACY=
VITE_URL_TERMS=
VITE_URL_REFUND=

# VSLs no YouTube (vazio = usa os vídeos atuais; informe só o ID do vídeo)
VITE_YOUTUBE_PRESENTATION=
VITE_YOUTUBE_SPORTS=
VITE_YOUTUBE_PLATFORM=

# ============================================================
#  META PIXEL (navegador)
# ============================================================
VITE_META_PIXEL_ID=1461637372773478
VITE_META_CAPI_ENDPOINT=/api/meta-event.php
# false = desliga o envio ao servidor (em "npm run dev" já fica desligado)
VITE_META_CAPI_ENABLED=true

# ============================================================
#  SERVIDOR (Conversions API / Braip) — NÃO PREENCHA AQUI
# ============================================================
# Estes valores ficam SOMENTE no arquivo privado da Hostinger:
#   domains/seudominio/vprime-private/config.php
# Modelo: hostinger/vprime-private/config.example.php — guia: hostinger/META-PIXEL-CAPI.md
# Nomes (valores FICTÍCIOS):
# META_PIXEL_ID=1461637372773478
# META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# META_GRAPH_VERSION=v26.0
# META_TEST_EVENT_CODE=TEST12345
# SITE_URL=https://seudominio.com.br
# BRAIP_POSTBACK_KEY=chave-unica-ficticia
# BRAIP_POSTBACK_MODE=inspect
